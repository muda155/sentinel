# Sentinel environment template — safe to commit. Copy to sentinel.env and fill in.
# Database
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=change_me_in_production
PGHOST=127.0.0.1
PGPORT=6432
PGDATABASE=sentinel
PGUSER=sentinel_user
PGPASSWORD=change_me_in_production

# PgBouncer
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_SIZE=20

# AI Services
NVIDIA_NIM_API_KEY=your_key_here
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
# Workers run in containers; localhost there is the container itself.
OLLAMA_ENDPOINT=http://host.docker.internal:11434
# Ollama fallback model; must be pulled on the host (8GB Macs: llama3.2:3b)
SENTINEL_OLLAMA_MODEL=llama3:8b

# External APIs — ACLED uses myACLED OAuth (password grant); set both to enable ingestion
ACLED_EMAIL=your_email_here
ACLED_PASSWORD=your_password_here

# Pipeline Parameters (defaults applied if omitted)
SENTINEL_LOOKBACK_HOURS=24
SENTINEL_DBSCAN_WINDOW_HOURS=2
SENTINEL_DBSCAN_EPS_KM=50
SENTINEL_DBSCAN_MIN_SAMPLES=3
SENTINEL_MAX_TIME_DIFF_H=1
SENTINEL_LLM_THRESHOLD=40
SENTINEL_GRID_SIZE_DEG=1.0
SENTINEL_ACLED_POLL_HOURS=24
SENTINEL_ACLED_FETCH_DAYS=7
SENTINEL_LLM_MAX_TOKENS=500
SENTINEL_LLM_TEMPERATURE=0.0
# Must exceed 70B NIM generation time or every call times out into fallback.
SENTINEL_LLM_TIMEOUT_S=180
SENTINEL_RETENTION_DAYS=90
SENTINEL_POLL_INTERVAL_S=900

# conf_score calibration (FR-7/8/9). Defaults reproduce the spec formula.
SENTINEL_CONF_W_DENSITY=0.7
SENTINEL_CONF_W_DIVERSITY=0.3
SENTINEL_CONF_DENSITY_DIVISOR=3

# M3 — Auth (inject real secret from secrets manager in production)
SENTINEL_JWT_SECRET=change_me_in_production_32_bytes__xxxx!
SENTINEL_JWT_ALG=HS256
SENTINEL_JWT_TTL_MIN=720
SENTINEL_ENV=development
# Comma-separated direct peers trusted to supply a real client IP in
# X-Forwarded-For (the Compose reverse proxy). Rate limits key on the forwarded
# IP only for these peers; leave empty when the API is directly exposed, so the
# limiter keys on the socket peer and a spoofable header is never trusted.
SENTINEL_TRUSTED_PROXIES=

# Infrastructure
REDIS_URL=redis://localhost:6379
LOG_LEVEL=INFO

# M6 Consistency Engine (FR-22)
SENTINEL_NLI_MODEL=cross-encoder/nli-deberta-v3-base
SENTINEL_NLI_MIN_PROB=0.6
SENTINEL_CONSISTENCY_DISPUTE_RATIO=0.5
SENTINEL_CONSISTENCY_MAX_CLAIMS=8
SENTINEL_CONSISTENCY_MAX_DOMAINS=20
SENTINEL_CONSISTENCY_MIN_CLAIM_WORDS=4

# M7 — GKG headline enrichment (FR-25). Set SENTINEL_GKG_ENABLED=false to fall
# back to Actor1Name titles without a redeploy. A GKG file is ~5 MB per tick.
SENTINEL_GKG_ENABLED=true
SENTINEL_GKG_TIMEOUT_S=120
SENTINEL_GKG_BACKFILL_DAYS=7

# M8 — Relevance gate (FR-26). Fail-closed: with the model unavailable the
# engine skips rather than judging ungated. Set ENABLED=false to revert to
# M6 behaviour, which is known-degraded.
SENTINEL_RELEVANCE_ENABLED=true
SENTINEL_RELEVANCE_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTINEL_RELEVANCE_MIN_SIM=0.35
SENTINEL_RELEVANCE_MIN_PEAK=0.15
SENTINEL_RELEVANCE_MAX_HOMOGENEITY=0.75

# M9 (FR-29) window narrative report
SENTINEL_REPORT_RATE_PER_MIN=4
SENTINEL_REPORT_TIMEOUT_S=30
